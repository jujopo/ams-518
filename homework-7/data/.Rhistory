load(PSG)
library(PSG)
#create the problem list
problem_list_1 <- list()
#create a matrix of scenarios, i.e.,  observations (theta_1,theta_2,y)
matrix_1 <- matrix(rnorm(12, 0, 1), ncol = 3)
#give column names
colnames(matrix_1) <- c("x1", "x2", "scenario_benchmark")
#create a matrix of coefficents for linear constraints
matrix_2 <- matrix(c(2, 1), ncol = 2)
#give col names
colnames(matrix_2) <- c("x1", "x2")
#create a matrix for cardinality constraint
matrix_3 <- matrix(c(1,1,0),ncol = 3)
colnames(matrix_3) <- c("x1", "x2", "scenario_benchmark")
#fill the list
problem_list_1$matrix_scenario <- matrix_1
problem_list_1$matrix_linear_constraints <- matrix_2
problem_list_1$matrix_constraint_card_new <- matrix_3
problem_list_1$problem_statement <- sprintf (
"
minimize
Meanabs_err(matrix_scenario)
Constraint: <= 2
linear(matrix_linear_constraints)
Constraint: <= 1, linearize = 1
cardn(0.001, matrix_constraint_card_new)
Box: >= 0
Solver: car
"
)
#calculate and store the results
results_1 <- rpsg_solver(problem_list = problem_list_1)
# Load the libraries we need to use
library(PSG)
library(dplyr)
library(tidyr)
library(xts)
library(ggplot2)
setwd("C:/Users/JUANJO/Documents/GitHub/ams-518/homework-7/data")
# Set path to Rdata file including the RData file's name with CS:
load("C:/Users/JUANJO/Documents/GitHub/ams-518/homework-7/data/problem_st_dev_risk.RData")
# Check what is the current problem statement
problem.list$problem_statement
# Modify the problem statement
problem.list$problem_statement[1] <- "for {matrix_fact_in; matrix_fact_out; num} = crossvalidation(5, matrix_scenarios)"
problem.list$problem_statement[2] <- "minimize"
problem.list$problem_statement[3] <- "cvar_dev(0.95,matrix_fact_in)"
problem.list$problem_statement[4] <- "Value:"
problem.list$problem_statement[5] <- "L_num(matrix_fact_out)"
problem.list$problem_statement[6] <- "L_num(matrix_fact_in)"
problem.list$problem_statement[7] <- "cvar_dev(0.95, matrix_fact_in)"
problem.list$problem_statement[8] <- "meanabs_dev(matrix_fact_in)"
problem.list$problem_statement[9] <- "st_dev(matrix_fact_in)"
problem.list$problem_statement[10] <- "var_risk(0.75, matrix_fact_in)"
problem.list$problem_statement[11] <- "var_risk_g(0.75, matrix_fact_in)"
problem.list$problem_statement[12] <- "var_risk(0.9, matrix_fact_in)"
problem.list$problem_statement[13] <- "var_risk_g(0.9, matrix_fact_in)"
problem.list$problem_statement[14] <- "end for"
# Save the problem statement for future iterations
problem_statement <- problem.list$problem_statement
# Extract the original 3-factor matrix (e.g., 1000 rows, 4 cols)
matrix_scenarios_3fact <- problem.list$matrix_scenarios
# Last name: Perez, hence I should pick variables x2 and x3
matrix_scenarios_2fact <- matrix_scenarios_3fact[, c(2, 3, 4)]
# Create a sequence of training sizes of 5, 10, 15, 20, 40, 60, ..., 900
training_sizes <- c(5, 10, 15, seq(20, 900, by = 20))
# Number of times we are going to run each simulation (minimum = 20)
n_repetitions <- 25
# Total number of rows
n_total_rows <- nrow(matrix_scenarios_3fact)
# Testing set will always contain 100 rows
n_test <- 100
all_indices <- 1:n_total_rows
# Initialize the results storage
# This data frame will store the final average for each training size
results_df <- data.frame(
TrainingSize = integer(),
# 2-Factor In-Sample (x2, x3)
Avg_InSample_2F_f1 = double(), # x2
Avg_InSample_2F_f2 = double(), # x3
# 2-Factor Out-of-Sample
Avg_OutOfSample_2F_f1 = double(), # x2
Avg_OutOfSample_2F_f2 = double(), # x3
# 3-Factor In-Sample (x1, x2, x3)
Avg_InSample_3F_f1 = double(), # x1
Avg_InSample_3F_f2 = double(), # x2
Avg_InSample_3F_f3 = double(), # x3
# 3-Factor Out-of-Sample
Avg_OutOfSample_3F_f1 = double(), # x1
Avg_OutOfSample_3F_f2 = double(), # x2
Avg_OutOfSample_3F_f3 = double() # x3
)
# Initialize the problem lists
problem.list.in.2f <- problem.list # Use the existing problem.list
problem.list.in.3f <- problem.list # Use the existing problem.list
# Outer loop: to iterate over each training size
for (n_train in training_sizes) {
print(paste("Starting Training Size:", n_train))
# Temporary matrices to store the average vectors from each rep
# Matrix: (n_repetitions x 2 factors)
in_sample_2f_reps <- matrix(NA, nrow = n_repetitions, ncol = 2)
# Matrix: (n_repetitions x 3 factors)
in_sample_3f_reps <- matrix(NA, nrow = n_repetitions, ncol = 3)
# Temporary vectors to store results for the 30 repetitions
out_sample_2f_reps <- matrix(NA, nrow = n_repetitions, ncol = 2)
out_sample_3f_reps <- matrix(NA, nrow = n_repetitions, ncol = 3)
# Repeat the experiment 30 times
for (i in 1:n_repetitions) {
# Step I: Randomly select 100 rows for testing set
test_indices <- sample(all_indices, n_test)
remaining_indices <- setdiff(all_indices, test_indices) # 900 remaining
# Step II: Randomly select n_train rows from remaining
train_indices <- sample(remaining_indices, n_train)
# Create the training and testing matrices for this iteration
matrix_train_set_3f <- matrix_scenarios_3fact[train_indices, ]
matrix_test_set_3f  <- matrix_scenarios_3fact[test_indices, ]
matrix_train_set_2f <- matrix_scenarios_2fact[train_indices, ]
matrix_test_set_2f  <- matrix_scenarios_2fact[test_indices, ]
#Step III: Fit models and get In-Sample CVaR Deviation
# 2-Factor In-Sample
# Modify the first entry of the statement
problem.list.in.2f$problem_statement[1] <-
"for {matrix_fact_in; matrix_fact_out; num} = crossvalidation(5, matrix_train_set_2f)"
# Modify the training set
problem.list.in.2f$matrix_scenarios <- matrix_train_set_2f
# Generate output for 2 factor model
output_in_2f <- rpsg_solver(problem.list.in.2f)
# Extract the CVaR value from each of the 5 list items and average them
cvar_vals_2f <- lapply(output_in_2f, function(x) {
# Find the element that starts with "point_problem_"
point_name <- grep("^point_problem_", names(x), value = TRUE)
if(length(point_name) > 0) {
return(x[[point_name]])
} else {
return(NULL)
}
})
# Extract x2 values and average
avg_x2_2f <- mean(sapply(cvar_vals_2f, `[`, "x2"))
# Extract x3 values and average
avg_x3_2f <- mean(sapply(cvar_vals_2f, `[`, "x3"))
# Fill in the averaged values
in_sample_2f_reps[i,] <- c(avg_x2_2f, avg_x3_2f)
# 3-Factor In-Sample
# Modify the first entry of the statement
problem.list.in.3f$problem_statement[1] <-
"for {matrix_fact_in; matrix_fact_out; num} = crossvalidation(5, matrix_train_set_3f)"
# Modify the training set
problem.list.in.3f$matrix_scenarios <- matrix_train_set_3f
output_in_3f <- rpsg_solver(problem.list.in.3f)
# Extract the CVaR value from each of the 5 list items and average them
cvar_vals_3f <- lapply(output_in_3f, function(x) {
# Find the element that starts with "point_problem_"
point_name <- grep("^point_problem_", names(x), value = TRUE)
if(length(point_name) > 0) {
return(x[[point_name]])
} else {
return(NULL)
}
})
# Extract x1 values and average
avg_x1_3f <- mean(sapply(cvar_vals_3f, `[`, "x1"))
# Extract x2 values and average
avg_x2_3f <- mean(sapply(cvar_vals_3f, `[`, "x2"))
# Extract x3 values and average
avg_x3_3f <- mean(sapply(cvar_vals_3f, `[`, "x3"))
# Fill in the averaged values
in_sample_3f_reps[i,] <- c(avg_x1_3f, avg_x2_3f, avg_x3_3f)
# Step IV: Calculate Out-Of-Sample CVaR Deviation
# 2-Factor Out-of-Sample
problem.list.out.2f <- list()
problem.list.out.2f$problem_statement[1] <- "minimize"
problem.list.out.2f$problem_statement[2] <- "cvar_dev(0.95, matrix_s)"
# Get the number of rows from the test set
n_rows_2f <- nrow(matrix_test_set_2f)
# Create the intercept column (1s)
intercept <- rep(1, n_rows_2f)
# Build the new matrix in the required order:
# [intercept, scenario_benchmark, x2, x3]
matrix_s_2f <- cbind(
intercept = intercept,
scenario_benchmark =  matrix_test_set_2f[, 3], # 3rd col (scenario_benchmark)
x2 = matrix_test_set_2f[, 1],                 # 1st col (x2)
x3 = matrix_test_set_2f[, 2]                  # 2nd col (x3)
)
problem.list.out.2f$matrix_s <- matrix_s_2f
output_out_2f <- rpsg_solver(problem.list.out.2f)
# Extract x2 value
x2_2f <- output_out_2f$point_problem_1["x2"]
# Extract x3 value
x3_2f <- output_out_2f$point_problem_1["x3"]
out_sample_2f_reps[i,] <- c(x2_2f, x3_2f)
# 3-Factor Out-of-Sample
problem.list.out.3f <- list()
problem.list.out.3f$problem_statement[1] <- "minimize"
problem.list.out.3f$problem_statement[2] <- "cvar_dev(0.95, matrix_s)"
# Get the number of rows from the test set
n_rows_3f <- nrow(matrix_test_set_3f)
# Create the intercept column (1s)
intercept <- rep(1, n_rows_3f)
# Build the new matrix in the required order:
# [intercept, scenario_benchmark, x1, x2, x3]
matrix_s_3f <- cbind(
intercept = intercept,
scenario_benchmark = matrix_test_set_3f[, 4], # 4th col (scenario_benchmark)
x1 = matrix_test_set_3f[, 1],                 # 1st col (x1)
x2 = matrix_test_set_3f[, 2],                 # 2nd col (x2)
x3 = matrix_test_set_3f[, 3]                  # 3rd col (x3)
)
problem.list.out.3f$matrix_s <- matrix_s_3f
output_out_3f <- rpsg_solver(problem.list.out.3f)
# Extract x1 value
x1_3f <- output_out_3f$point_problem_1["x1"]
# Extract x2 value
x2_3f <- output_out_3f$point_problem_1["x2"]
# Extract x3 value
x3_3f <- output_out_3f$point_problem_1["x3"]
out_sample_3f_reps[i,] <- c(x1_3f, x2_3f, x3_3f)
} # End of middle loop (n_repetitions)
# Step V: Calculate averages
avg_in_2f  <- colMeans(in_sample_2f_reps, na.rm = TRUE)
avg_in_3f  <- colMeans(in_sample_3f_reps, na.rm = TRUE)
avg_out_2f  <- colMeans(out_sample_2f_reps, na.rm = TRUE)
avg_out_3f  <- colMeans(out_sample_3f_reps, na.rm = TRUE)
# Store the averages in the main results data frame
results_df <- rbind(results_df, data.frame(
TrainingSize = n_train,
Avg_InSample_2F_f1 = avg_in_2f[1], # Corresponds to x2
Avg_InSample_2F_f2 = avg_in_2f[2], # Corresponds to x3
Avg_OutOfSample_2F_f1 = avg_out_2f[1], # Corresponds to x2
Avg_OutOfSample_2F_f2 = avg_out_2f[2], # Corresponds to x3
Avg_InSample_3F_f1 = avg_in_3f[1], # Corresponds to x1
Avg_InSample_3F_f2 = avg_in_3f[2], # Corresponds to x2
Avg_InSample_3F_f3 = avg_in_3f[3], # Corresponds to x3
Avg_OutOfSample_3F_f1 = avg_out_3f[1], # Corresponds to x1
Avg_OutOfSample_3F_f2 = avg_out_3f[2], # Corresponds to x2
Avg_OutOfSample_3F_f3 = avg_out_3f[3] # Corresponds to x3
))
} # End of outer loop (training_sizes)
save.image(file = "problem_st_dev_risk.RData")
print(results_df)
View(results_df)
head(results_df)
# Pivot the data from its wide format (10 metric columns)
# to a long format (3 columns: SampleType, Factor, CVaR_Deviation)
results_long <- results_df %>%
pivot_longer(
cols = -TrainingSize,
names_to = "MetricName",
values_to = "CVaR_Deviation"
) %>%
# Create new columns based on the metric names
mutate(
SampleType = ifelse(grepl("InSample", MetricName), "In-Sample", "Out-of-Sample"),
# Create descriptive labels for each line
Factor = case_when(
MetricName == "Avg_InSample_2F_f1" ~ "2-Factor (x2)",
MetricName == "Avg_InSample_2F_f2" ~ "2-Factor (x3)",
MetricName == "Avg_OutOfSample_2F_f1" ~ "2-Factor (x2)",
MetricName == "Avg_OutOfSample_2F_f2" ~ "2-Factor (x3)",
MetricName == "Avg_InSample_3F_f1" ~ "3-Factor (x1)",
MetricName == "Avg_InSample_3F_f2" ~ "3-Factor (x2)",
MetricName == "Avg_InSample_3F_f3" ~ "3-Factor (x3)",
MetricName == "Avg_OutOfSample_3F_f1" ~ "3-Factor (x1)",
MetricName == "Avg_OutOfSample_3F_f2" ~ "3-Factor (x2)",
MetricName == "Avg_OutOfSample_3F_f3" ~ "3-Factor (x3)",
TRUE ~ MetricName
),
# Create a simple "Model" column for grouping
Model = ifelse(grepl("2F", MetricName), "2-Factor", "3-Factor")
)
# Create the plot
# This plot shows all 10 lines, grouped by model and sample type
ggplot(results_long,
aes(x = TrainingSize,
y = CVaR_Deviation,
color = Factor,          # Color lines by the specific factor
linetype = SampleType)) +  # Dash lines by In/Out-of-Sample
geom_line(linewidth = 1) +
geom_point(size = 2) +
# Use 'facet_wrap' to split the plot into two clean charts:
# One for the 2-Factor model, one for the 3-Factor model.
# This is much easier to read than 10 lines on one chart.
facet_wrap(~ Model, scales = "free_y") +
labs(
title = "Model Performance vs. Training Set Size",
subtitle = "Comparing In-Sample (dashed) and Out-of-Sample (solid) CVaR Deviations",
x = "Number of Rows in Training Set",
y = "Average CVaR Deviation (0.95)",
color = "Factor",
linetype = "Sample Type"
) +
scale_linetype_manual(values = c("In-Sample" = "dashed", "Out-of-Sample" = "solid")) +
theme_minimal() +
# Use a color palette that can handle many lines
scale_color_brewer(palette = "Paired")
# Pivot the data to a long format
results_long_individual <- results_df %>%
pivot_longer(
cols = -TrainingSize,
names_to = "MetricName",
values_to = "CVaR_Deviation"
) %>%
mutate(
# Column for the line type (In vs. Out)
SampleType = ifelse(grepl("InSample", MetricName), "In-Sample", "Out-of-Sample"),
# Column to identify each plot
FactorGroup = case_when(
grepl("2F_f1", MetricName) ~ "x2 (from 2-Factor Model)",
grepl("2F_f2", MetricName) ~ "x3 (from 2-Factor Model)",
grepl("3F_f1", MetricName) ~ "x1 (from 3-Factor Model)",
grepl("3F_f2", MetricName) ~ "x2 (from 3-Factor Model)",
grepl("3F_f3", MetricName) ~ "x3 (from 3-Factor Model)",
TRUE ~ "Unknown"
)
) %>%
# Filter out any potential mismatches
filter(FactorGroup != "Unknown")
# Get the list of unique plot groups
factor_list <- unique(results_long_individual$FactorGroup)
# Create an empty list to store the individual ggplot objects
plot_list <- list()
# Loop through each factor group and create a plot
for (current_factor in factor_list) {
# Filter the data for *only* this factor group
plot_data <- results_long_individual %>%
filter(FactorGroup == current_factor)
# Create the ggplot object
p <- ggplot(plot_data, aes(x = TrainingSize,
y = CVaR_Deviation,
color = SampleType,
linetype = SampleType)) +
geom_line(linewidth = 1.2) +
geom_point(size = 2.5, alpha = 0.8) +
labs(
title = paste("Model Performance for:", current_factor),
subtitle = "Comparing In-Sample vs. Out-of-Sample CVaR Deviation",
x = "Number of Rows in Training Set",
y = "Average CVaR Deviation (0.95)",
color = "Sample Type",
linetype = "Sample Type"
) +
# Use distinct colors AND linetypes to be very clear
scale_color_manual(values = c("In-Sample" = "blue", "Out-of-Sample" = "red")) +
scale_linetype_manual(values = c("In-Sample" = "dashed", "Out-of-Sample" = "solid")) +
theme_minimal(base_size = 14) +
theme(legend.position = "bottom")
# Add the plot to our list, named by its factor
plot_list[[current_factor]] <- p
}
print(plot_list[["x2 (from 2-Factor Model)"]])
print(plot_list[["x3 (from 2-Factor Model)"]])
print(plot_list[["x1 (from 3-Factor Model)"]])
print(plot_list[["x2 (from 3-Factor Model)"]])
print(plot_list[["x3 (from 3-Factor Model)"]])
