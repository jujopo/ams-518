# Number of times we are going to run each simulation (minimum = 20)
n_repetitions <- 30
# Total number of rows
n_total_rows <- nrow(matrix_scenarios_3fact)
# Testing set will always contain 100 rows
n_test <- 100
all_indices <- 1:n_total_rows
n_train <- 10
# This data frame will store the final average for each training size
results_df <- data.frame(
TrainingSize = integer(),
# 2-Factor In-Sample (x2, x3)
Avg_InSample_2F_f1 = double(), # x2
Avg_InSample_2F_f2 = double(), # x3
# 2-Factor Out-of-Sample
Avg_OutOfSample_2F_f1 = double(), # x2
Avg_OutOfSample_2F_f2 = double(), # x3
# 3-Factor In-Sample (x1, x2, x3)
Avg_InSample_3F_f1 = double(), # x1
Avg_InSample_3F_f2 = double(), # x2
Avg_InSample_3F_f3 = double(), # x3
# 3-Factor Out-of-Sample
Avg_OutOfSample_3F_f1 = double(), # x1
Avg_OutOfSample_3F_f2 = double(), # x2
Avg_OutOfSample_3F_f3 = double() # x3
)
print(paste("--- Starting Training Size:", n_train, "---"))
# Temporary matrices to store the average vectors from each rep
# Matrix: (n_repetitions x 2 factors)
in_sample_2f_reps <- matrix(NA, nrow = n_repetitions, ncol = 2)
# Matrix: (n_repetitions x 3 factors)
in_sample_3f_reps <- matrix(NA, nrow = n_repetitions, ncol = 3)
# Temporary vectors to store results for the 30 repetitions
out_sample_2f_reps <- matrix(NA, nrow = n_repetitions, ncol = 2)
out_sample_3f_reps <- matrix(NA, nrow = n_repetitions, ncol = 3)
# Repeat the experiment 30 times
for (i in 1:n_repetitions) {
# Step I: Randomly select 100 rows for testing set
test_indices <- sample(all_indices, n_test)
remaining_indices <- setdiff(all_indices, test_indices) # 900 remaining
# Step II: Randomly select n_train rows from remaining
train_indices <- sample(remaining_indices, n_train)
# Create the training and testing matrices for this iteration
matrix_train_set_3f <- matrix_scenarios_3fact[train_indices, ]
matrix_test_set_3f  <- matrix_scenarios_3fact[test_indices, ]
matrix_train_set_2f <- matrix_scenarios_2fact[train_indices, ]
matrix_test_set_2f  <- matrix_scenarios_2fact[test_indices, ]
#Step III: Fit models and get In-Sample CVaR Deviation
# 2-Factor In-Sample
# Modify the first entry of the statement
problem.list.in.2f$problem_statement[1] <-
"for {matrix_fact_in; matrix_fact_out; num} = crossvalidation(5, matrix_train_set_2f)"
# Modify the training set
problem.list.in.2f$matrix_scenarios <- matrix_train_set_2f
# Generate output for 2 factor model
output_in_2f <- rpsg_solver(problem.list.in.2f)
# Extract the CVaR value from each of the 5 list items and average them
cvar_vals_2f <- lapply(output_in_2f, function(x) {
# Find the element that starts with "point_problem_"
point_name <- grep("^point_problem_", names(x), value = TRUE)
if(length(point_name) > 0) {
return(x[[point_name]])
} else {
return(NULL)
}
})
# Extract x2 values and average
avg_x2_2f <- mean(sapply(cvar_vals_2f, `[`, "x2"))
# Extract x3 values and average
avg_x3_2f <- mean(sapply(cvar_vals_2f, `[`, "x3"))
# Fill in the averaged values
in_sample_2f_reps[i,] <- c(avg_x2_2f, avg_x3_2f)
# 3-Factor In-Sample
# Modify the first entry of the statement
problem.list.in.3f$problem_statement[1] <-
"for {matrix_fact_in; matrix_fact_out; num} = crossvalidation(5, matrix_train_set_3f)"
# Modify the training set
problem.list.in.3f$matrix_scenarios <- matrix_train_set_3f
output_in_3f <- rpsg_solver(problem.list.in.3f)
# Extract the CVaR value from each of the 5 list items and average them
cvar_vals_3f <- lapply(output_in_3f, function(x) {
# Find the element that starts with "point_problem_"
point_name <- grep("^point_problem_", names(x), value = TRUE)
if(length(point_name) > 0) {
return(x[[point_name]])
} else {
return(NULL)
}
})
# Extract x1 values and average
avg_x1_3f <- mean(sapply(cvar_vals_3f, `[`, "x1"))
# Extract x2 values and average
avg_x2_3f <- mean(sapply(cvar_vals_3f, `[`, "x2"))
# Extract x3 values and average
avg_x3_3f <- mean(sapply(cvar_vals_3f, `[`, "x3"))
# Fill in the averaged values
in_sample_3f_reps[i,] <- c(avg_x1_3f, avg_x2_3f, avg_x3_3f)
# Step IV: Calculate Out-Of-Sample CVaR Deviation
# 2-Factor Out-of-Sample
problem.list.out.2f <- list()
problem.list.out.2f$problem_statement[1] <- "minimize"
problem.list.out.2f$problem_statement[2] <- "cvar_dev(0.95, matrix_s)"
# Get the number of rows from the test set
n_rows_2f <- nrow(matrix_test_set_2f)
# Create the intercept column (1s)
intercept <- rep(1, n_rows_2f)
# Build the new matrix in the required order:
# [intercept, scenario_benchmark, x2, x3]
matrix_s_2f <- cbind(
intercept = intercept,
scenario_benchmark =  matrix_test_set_2f[, 3], # 3rd col (scenario_benchmark)
x2 = matrix_test_set_2f[, 1],                 # 1st col (x2)
x3 = matrix_test_set_2f[, 2]                  # 2nd col (x3)
)
problem.list.out.2f$matrix_s <- matrix_s_2f
output_out_2f <- rpsg_solver(problem.list.out.2f)
# Extract x2 value
x2_2f <- output_out_2f$point_problem_1["x2"]
# Extract x3 value
x3_2f <- output_out_2f$point_problem_1["x3"]
out_sample_2f_reps[i,] <- c(x2_2f, x3_2f)
# 3-Factor Out-of-Sample
problem.list.out.3f <- list()
problem.list.out.3f$problem_statement[1] <- "minimize"
problem.list.out.3f$problem_statement[2] <- "cvar_dev(0.95, matrix_s)"
