out_sample_2f_reps[i,] <- c(x2_2f, x3_2f)
# 3-Factor Out-of-Sample
problem.list.out.3f <- list()
problem.list.out.3f$problem_statement[1] <- "minimize"
problem.list.out.3f$problem_statement[2] <- "cvar_dev(0.95, matrix_s)"
# Get the number of rows from the test set
n_rows_3f <- nrow(matrix_test_set_3f)
# Create the intercept column (1s)
intercept <- rep(1, n_rows_3f)
# Build the new matrix in the required order:
# [intercept, scenario_benchmark, x1, x2, x3]
matrix_s_3f <- cbind(
intercept = intercept,
scenario_benchmark = matrix_test_set_3f[, 4], # 4th col (scenario_benchmark)
x1 = matrix_test_set_3f[, 1],                 # 1st col (x1)
x2 = matrix_test_set_3f[, 2],                 # 2nd col (x2)
x3 = matrix_test_set_3f[, 3]                  # 3rd col (x3)
)
problem.list.out.3f$matrix_s <- matrix_s_3f
output_out_3f <- rpsg_solver(problem.list.out.3f)
# Extract x1 value
x1_3f <- output_out_3f$point_problem_1["x1"]
# Extract x2 value
x2_3f <- output_out_3f$point_problem_1["x2"]
# Extract x3 value
x3_3f <- output_out_3f$point_problem_1["x3"]
out_sample_3f_reps[i,] <- c(x1_3f, x2_3f, x3_3f)
} # End of middle loop (n_repetitions)
# Step V: Calculate averages
avg_in_2f  <- colMeans(in_sample_2f_reps, na.rm = TRUE)
avg_in_3f  <- colMeans(in_sample_3f_reps, na.rm = TRUE)
avg_out_2f  <- colMeans(out_sample_2f_reps, na.rm = TRUE)
avg_out_3f  <- colMeans(out_sample_3f_reps, na.rm = TRUE)
# Store the averages in the main results data frame
results_df <- rbind(results_df, data.frame(
TrainingSize = n_train,
Avg_InSample_2F_f1 = avg_in_2f[1], # Corresponds to x2
Avg_InSample_2F_f2 = avg_in_2f[2], # Corresponds to x3
Avg_OutOfSample_2F_f1 = avg_out_2f[1], # Corresponds to x2
Avg_OutOfSample_2F_f2 = avg_out_2f[2], # Corresponds to x3
Avg_InSample_3F_f1 = avg_in_3f[1], # Corresponds to x1
Avg_InSample_3F_f2 = avg_in_3f[2], # Corresponds to x2
Avg_InSample_3F_f3 = avg_in_3f[3], # Corresponds to x3
Avg_OutOfSample_3F_f1 = avg_out_3f[1], # Corresponds to x1
Avg_OutOfSample_3F_f2 = avg_out_3f[2], # Corresponds to x2
Avg_OutOfSample_3F_f3 = avg_out_3f[3] # Corresponds to x3
))
} # End of outer loop (training_sizes)
# Final Results
print("Simulation Complete. Final averaged results:")
print(results_df)
View(results_df)
save.image(file = "problem_CVaR2_err_075.RData")
