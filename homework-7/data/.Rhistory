x2_3f <- output_out_3f$point_problem_1["x2"]
# Extract x3 value
x3_3f <- output_out_3f$point_problem_1["x3"]
out_sample_3f_reps[i,] <- c(x1_3f, x2_3f, x3_3f)
} # End of middle loop (n_repetitions)
